  "keyFeatures": [
    "Discrete event simulation engine with priority-based queuing",
    "Real-time visualization of queue state and teller operations",
    "Comprehensive metrics dashboard with wait time and throughput analysis",
    "Configurable arrival rates using Poisson distribution",
    "Multi-teller resource management with dynamic allocation",
    "Priority-based customer service (High, Medium, Low)",
    "Interactive simulation controls (start, pause, stop)",
    "Hexagonal architecture with clean separation of concerns"
  ],
